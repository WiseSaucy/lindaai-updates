<?xml version="1.0" encoding="UTF-8"?>
<!--
  LindaAI Discord Bridge — launchd plist TEMPLATE.

  TO ACTIVATE (one-time setup):
    1. Build a venv for the bot (Python sees discord.py from inside the venv):
         python3 -m venv ~/.claude/lindaai/discord-bridge/venv
         ~/.claude/lindaai/discord-bridge/venv/bin/pip install discord.py

    2. Copy this template:
         cp com.lindaai.discord-bridge.plist.template \
            ~/Library/LaunchAgents/com.lindaai.discord-bridge.plist

    3. Edit the plist below:
       - REPLACE PASTE_YOUR_OAUTH_TOKEN_HERE with token from `claude setup-token`
       - REPLACE every `/Users/Saucy` with `/Users/yourname` (your macOS username)
         (Tip: in TextEdit, Cmd+F → find `/Users/Saucy` → replace with your home dir)

    4. Load it:
         launchctl load ~/Library/LaunchAgents/com.lindaai.discord-bridge.plist

    5. Bot now auto-starts at login + auto-restarts on crash.
       Logs: ~/.claude/lindaai/discord-bridge.out.log

  TO STOP / DISABLE:
    launchctl unload ~/Library/LaunchAgents/com.lindaai.discord-bridge.plist

  This mirrors the Telegram bridge plist setup (uses a venv so discord.py
  resolves cleanly — system python3 doesn't see --user pip installs).
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.lindaai.discord-bridge</string>

	<key>EnvironmentVariables</key>
	<dict>
		<!-- REPLACE with token from `claude setup-token` -->
		<key>CLAUDE_CODE_OAUTH_TOKEN</key>
		<string>PASTE_YOUR_OAUTH_TOKEN_HERE</string>

		<!-- REPLACE /Users/Saucy with your macOS home directory -->
		<key>HOME</key>
		<string>/Users/Saucy</string>

		<key>PATH</key>
		<string>/Users/Saucy/.npm-global/bin:/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
	</dict>

	<!-- Uses the venv's python (which has discord.py installed) -->
	<key>ProgramArguments</key>
	<array>
		<string>/Users/Saucy/.claude/lindaai/discord-bridge/venv/bin/python3</string>
		<string>-u</string>
		<string>/Users/Saucy/.claude/lindaai/discord-bridge/bot.py</string>
	</array>

	<key>WorkingDirectory</key>
	<string>/Users/Saucy/.claude/lindaai/discord-bridge</string>

	<key>RunAtLoad</key>
	<true/>

	<key>KeepAlive</key>
	<dict>
		<key>NetworkState</key>
		<true/>
		<key>SuccessfulExit</key>
		<false/>
	</dict>

	<key>ProcessType</key>
	<string>Background</string>

	<key>ThrottleInterval</key>
	<integer>15</integer>

	<key>StandardOutPath</key>
	<string>/Users/Saucy/.claude/lindaai/discord-bridge.out.log</string>

	<key>StandardErrorPath</key>
	<string>/Users/Saucy/.claude/lindaai/discord-bridge.err.log</string>
</dict>
</plist>
