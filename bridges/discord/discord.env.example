# =============================================================================
# LindaAI Discord Bridge — environment file
# =============================================================================
# Copy this to ~/.claude/lindaai/discord.env and fill in the blanks.
#
# Two auth paths (pick ONE — most folks want #1):
#
#   1. CLAUDE CODE MAX SUBSCRIPTION (recommended — NO API CHARGES)
#      - Run in terminal:  claude setup-token
#      - Follow the browser OAuth flow
#      - Copy the token it prints (starts with `sk-ant-oat01-...`)
#      - Paste below as CLAUDE_CODE_OAUTH_TOKEN
#      - Uses YOUR Claude Max sub. Bot messages don't cost extra.
#
#   2. ANTHROPIC API KEY (pay-per-use, ~$0.003/message)
#      - Get from console.anthropic.com/settings/keys
#      - Add at least $5 to billing at console.anthropic.com/settings/billing
#      - Paste below as ANTHROPIC_API_KEY
#      - Each /linda message costs fractions of a cent.
#
# After saving, chmod 600 this file so only you can read it:
#   chmod 600 ~/.claude/lindaai/discord.env
# =============================================================================

# --- DISCORD ----------------------------------------------------------------

# From discord.com/developers -> your app -> Bot -> Reset Token:
DISCORD_BOT_TOKEN=paste-bot-token-here

# Your Discord user ID. In Discord, enable Settings -> Advanced -> Developer Mode,
# then LEFT-CLICK your avatar (bottom-left) -> scroll down -> "Copy User ID".
# This locks the bot to YOU - no rando can use your slash commands.
DISCORD_ALLOWED_USER_ID=paste-your-user-id-here

# Server ID where slash commands sync INSTANTLY (no 1-hr global wait).
# LEFT-CLICK your server icon -> scroll down -> "Copy Server ID".
DISCORD_GUILD_ID=paste-your-server-id-here


# --- AUTH (PICK ONE - leave the other blank or remove) ----------------------

# Option 1 (RECOMMENDED): Claude Max subscription via OAuth
# Run `claude setup-token` to generate.
CLAUDE_CODE_OAUTH_TOKEN=

# Option 2 (fallback): Anthropic API key - billed per message
ANTHROPIC_API_KEY=


# --- OPTIONAL TUNING --------------------------------------------------------

# Model used by claude CLI. Defaults to claude-opus-4-7.
# CLAUDE_MODEL=claude-opus-4-7

# Project directory the bot runs in (where CLAUDE.md + skills load from).
# Defaults to the LindaAI folder this bridge lives in. Set this only to run claude somewhere else.
# CLAUDE_PROJECT_DIR=/Users/yourname/Desktop/LindaAI-Platinum

# Path to the claude CLI binary. Auto-detected if unset.
# CLAUDE_BIN=/Users/yourname/.npm-global/bin/claude
