# =============================================================================
# LindaAI Discord Bridge — environment file
# =============================================================================
# Copy this to ~/.claude/lindaai/discord.env and fill in the blanks.
#
# Two auth paths (pick ONE — most folks want #1):
#
#   1. CLAUDE CODE MAX SUBSCRIPTION (recommended — NO API CHARGES)
#      - Run in terminal:  claude setup-token
#      - Follow the browser OAuth flow
#      - Copy the token it prints (starts with `sk-ant-oat01-...`)
#      - Paste below as CLAUDE_CODE_OAUTH_TOKEN
#      - Uses YOUR Claude Max sub. Bot messages don't cost extra.
#
#   2. ANTHROPIC API KEY (pay-per-use, ~$0.003/message)
#      - Get from console.anthropic.com/settings/keys
#      - Add at least $5 to billing at console.anthropic.com/settings/billing
#      - Paste below as ANTHROPIC_API_KEY
#      - Each /linda message costs fractions of a cent.
#
# After saving, chmod 600 this file so only you can read it:
#   chmod 600 ~/.claude/lindaai/discord.env
# =============================================================================

# --- DISCORD ----------------------------------------------------------------

# From discord.com/developers -> your app -> Bot -> Reset Token:
DISCORD_BOT_TOKEN=paste-bot-token-here

# Who can use the bot. In Discord: Settings -> Advanced -> Developer Mode ON,
# then LEFT-CLICK an avatar -> "Copy User ID". Comma-separate multiple owners
# (e.g. you + your wife). No rando can use the slash commands.
DISCORD_ALLOWED_USER_IDS=paste-your-user-id-here
# (older singular form still works: DISCORD_ALLOWED_USER_ID=...)

# OPTIONAL — restrict a specific channel to specific people (IDs stay in THIS
# file, never in channels.json — that file is in the public repo).
# <KEY> = the channel key from channels.json, uppercased, dashes -> underscores:
# CHANNEL_ALLOWED_USERS_DEALS=partner-id,your-id
# CHANNEL_ALLOWED_USERS_LINDA_AI=your-id

# Server ID where slash commands sync INSTANTLY (no 1-hr global wait).
# LEFT-CLICK your server icon -> scroll down -> "Copy Server ID".
DISCORD_GUILD_ID=paste-your-server-id-here


# --- AUTH (PICK ONE - leave the other blank or remove) ----------------------

# Option 1 (RECOMMENDED): Claude Max subscription via OAuth
# Run `claude setup-token` to generate.
CLAUDE_CODE_OAUTH_TOKEN=

# Option 2 (fallback): Anthropic API key - billed per message
ANTHROPIC_API_KEY=


# --- OPTIONAL TUNING --------------------------------------------------------

# Model used by claude CLI. Defaults to claude-sonnet-4-5.
# CLAUDE_MODEL=claude-opus-4-7

# Project directory the bot runs in (where CLAUDE.md + skills load from).
# Defaults to the LindaAI folder this bridge lives in. Set this only to run claude somewhere else.
# CLAUDE_PROJECT_DIR=/Users/yourname/Desktop/LindaAI-Platinum

# Path to the claude CLI binary. Auto-detected if unset.
# CLAUDE_BIN=/Users/yourname/.npm-global/bin/claude


# --- PER-CHANNEL COMMANDS ---------------------------------------------------
#
# Which slash commands belong to which channel is controlled by channels.json
# (it sits next to bot.py). Each channel is fully isolated — its commands only
# work in its channel and only use its own skills (no crossings between
# Deals / Linda AI). Edit channels.json to add/rename channels or
# move commands around. No code changes needed.
#
# Override the config location if you keep it elsewhere:
# CHANNELS_CONFIG=/Users/yourname/.claude/lindaai/discord-bridge/channels.json


# --- MESSAGE TRIGGERS (talk without slash commands) -------------------------
#
# Set to 1 to let you JUST TYPE A PLAIN MESSAGE in a channel (no slash needed):
#   - In the Deals channel: paste a bare ADDRESS -> auto-runs the Sauce Underwriter.
#     (A message that ASKS for something — "draft an LOI for 123 Main St" —
#     goes to the channel assistant instead, which does what you asked.)
#   - In any channel with "auto_respond": true (channels.json): any plain message
#     is handled by THAT channel's assistant.
#
# ⚠ REQUIRES the privileged "Message Content Intent" FIRST: Discord dev portal
# -> your app -> Bot -> enable "MESSAGE CONTENT INTENT" -> Save. If you set 1
# without that toggle, the bot exits at startup with instructions.
# Default is 0 (slash-commands-only) so a fresh install always starts clean.
ENABLE_MESSAGE_TRIGGERS=0
# (legacy alias still honored: ENABLE_AUTO_UNDERWRITE=1)

# Max seconds per claude call before it's killed (default 300):
# CLAUDE_TIMEOUT_SECONDS=300
# Hours before a channel's conversation memory auto-resets (default 12).
# Use /reset in Discord to clear one conversation manually.
# SESSION_TTL_HOURS=12
